<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity BaggagePurchase: mua them hanh ly ky gui cho mot ve da
        mua, thanh toan qua VNPay (tai su dung ha tang Booking/Payment san co).
    -->
    <changeSet id="20260821100001-1" author="dugx">
        <createTable tableName="baggage_purchase">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="weight_kg" type="integer">
                <constraints nullable="false" />
            </column>
            <column name="price" type="decimal(21,2)">
                <constraints nullable="false" />
            </column>
            <column name="status" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="created_date" type="timestamp">
                <constraints nullable="true" />
            </column>
            <column name="ticket_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="booking_id" type="bigint">
                <constraints nullable="true" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
