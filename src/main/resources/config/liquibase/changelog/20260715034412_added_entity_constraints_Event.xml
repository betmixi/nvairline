<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Event.
    -->
    <changeSet id="20260715034412-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="category_id"
                                 baseTableName="event"
                                 constraintName="fk_event__category_id"
                                 referencedColumnNames="id"
                                 referencedTableName="category"
                                 />

        <addForeignKeyConstraint baseColumnNames="address_id"
                                 baseTableName="event"
                                 constraintName="fk_event__address_id"
                                 referencedColumnNames="id"
                                 referencedTableName="address"
                                 />

        <addForeignKeyConstraint baseColumnNames="organizer_id"
                                 baseTableName="event"
                                 constraintName="fk_event__organizer_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organizer"
                                 />
    </changeSet>
</databaseChangeLog>
